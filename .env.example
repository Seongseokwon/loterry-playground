# Prisma Postgres direct TCP connection string.
# Do not use a prisma:// or prisma+postgres:// Accelerate URL with PrismaPg.
DATABASE_URL="postgres://username:password@host:5432/database"

# GA4 Measurement ID, for example G-XXXXXXXXXX.
# Leave empty in local development to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
